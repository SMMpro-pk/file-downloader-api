# SMMpro File Downloader API — Configuration Example
# NOTE: This file is OPTIONAL documentation for local development.
# In Docker and production, NO .env file is required; the application starts with safe defaults.

# Environment & Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Dynamic Public URL Discovery
# Leave empty for automatic provider discovery (Render, Railway, Fly.io, Vercel, Heroku, Koyeb).
# Or set explicitly for custom domains, VPS, or reverse proxies:
PUBLIC_BASE_URL=
API_BASE_PATH=/api/v1
LOCAL_BASE_URL=

# Optional Frontend Application Base URL
FRONTEND_BASE_URL=

# Authentication & API Keys
# When API_KEY_REQUIRED=false, all endpoints are open without an API key.
# When API_KEY_REQUIRED=true:
#   - Supply a fixed key via API_KEY environment variable, OR
#   - Leave empty to automatically generate and persist a stable key in data/.api-key (retained across restarts)
API_KEY_REQUIRED=false
API_KEY=

# CORS & Networking (Default: * allows all origins; comma-separate origins to restrict)
CORS_ORIGINS=*
TRUST_PROXY=false
REQUEST_TIMEOUT_MS=10000
EXTRACT_TIMEOUT_MS=15000
MAX_REDIRECTS=5

# Size & Concurrency Limits
MAX_EXTRACTED_LINKS=50
MAX_FILE_SIZE_BYTES=1073741824
MAX_REQUEST_BODY_BYTES=32768
MAX_CONCURRENT_DOWNLOADS=5

# Rate Limits (Requests per Minute)
DETECTION_RATE_LIMIT=30
DOWNLOAD_RATE_LIMIT=10

# Logging & Feature Flags
LOG_LEVEL=info
ENABLE_ARCHIVE_INSPECTION=false
